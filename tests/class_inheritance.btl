import "system";

class Doughnut {
  func cook() {
    system.println("Fry until golden brown.");
  }
}

class BostonCream < Doughnut {
  func fill() {
    system.println("Insert custard.");
  }
}

var b = BostonCream();
b.cook(); // expect: Fry until golden brown.
b.fill(); // expect: Insert custard.