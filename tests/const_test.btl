import "system";

// Test constant folding
var a = 2 + 3;         // Should fold to 5
var b = 10 - 4;        // Should fold to 6
var c = 3 * 4;         // Should fold to 12
var d = 20 / 4;        // Should fold to 5
var e = -5;            // Should fold to -5

// Chain of constants
var f = 1 + 2 + 3;     // Should fold to 6

// Comparison folding
var g = 3 < 5;         // Should fold to true
var h = 10 > 20;       // Should fold to false

system.println("a = " + a);
system.println("b = " + b);
system.println("c = " + c);
system.println("d = " + d);
system.println("e = " + e);
system.println("f = " + f);
if (g) system.println("g = true"); else system.println("g = false");
if (h) system.println("h = true"); else system.println("h = false");
