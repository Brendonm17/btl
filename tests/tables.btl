import "system";

// Basic table creation
var empty = [:];
system.println(empty);  // expect: <table>

var t = ["name": "Alice", "age": 30, "active": true];
system.println(t);  // expect: <table>

// Get values
system.println(t["name"]);   // expect: Alice
system.println(t["age"]);    // expect: 30
system.println(t["active"]); // expect: true

// Non-existent key returns null
system.println(t["missing"]);  // expect: null

// Set values
t["city"] = "Seattle";
system.println(t["city"]);  // expect: Seattle

// Update existing
t["age"] = 99;
system.println(t["age"]);  // expect: 99

// Any type as key
var numKeys = [:];
numKeys[1] = "one";
numKeys[2.5] = "two point five";
numKeys[42] = "answer";
system.println(numKeys[1]);    // expect: one
system.println(numKeys[2.5]);  // expect: two point five
system.println(numKeys[42]);   // expect: answer

// Bool and null keys
var mixed = [:];
mixed[true] = "yes";
mixed[false] = "no";
mixed[null] = "nothing";
system.println(mixed[true]);   // expect: yes
system.println(mixed[false]);  // expect: no
system.println(mixed[null]);    // expect: nothing

// Nested tables
var users = [:];
users["alice"] = ["name": "Alice", "score": 100];
users["bob"] = ["name": "Bob", "score": 85];
system.println(users["alice"]["name"]);   // expect: Alice
system.println(users["alice"]["score"]);  // expect: 100
system.println(users["bob"]["name"]);     // expect: Bob

// Tables in lists
var data = [
    ["id": 1, "name": "first"],
    ["id": 2, "name": "second"]
];
system.println(data[0]["id"]);    // expect: 1
system.println(data[0]["name"]);  // expect: first
system.println(data[1]["id"]);    // expect: 2

// Lists as keys (identity-based)
var listKeys = [:];
var key1 = [1, 2, 3];
var key2 = [1, 2, 3];  // different object, same content
listKeys[key1] = "first";
listKeys[key2] = "second";
system.println(listKeys[key1]);  // expect: first
system.println(listKeys[key2]);  // expect: second

// Using variables as keys
var keyName = "dynamic";
var t2 = [:];
t2[keyName] = "value";
system.println(t2["dynamic"]);  // expect: value
system.println(t2[keyName]);    // expect: value

// Overwrite values
var counter = ["count": 0];
counter["count"] = counter["count"] + 1;
counter["count"] = counter["count"] + 1;
system.println(counter["count"]);  // expect: 2

// Empty table stays empty
var e = [:];
system.println(e["anything"]);  // expect: null

system.println("All table tests passed!");  // expect: All table tests passed!