import "system";

func map(list, fun) {
  var new_list = [];
  for (var i = 0; i < 3; i = i + 1) { // Assuming list length 3 for now
    new_list[i] = fun(list[i]);
  }
  return new_list;
}

func double(x) { return x * 2; }

var results = map([1, 2, 3], double);
system.println(results[0]); // expect: 2
system.println(results[1]); // expect: 4
system.println(results[2]); // expect: 6