import "system";

// Compound assignment operators
var x = 10;
x += 5;
system.println(x);  // expect: 15

x -= 3;
system.println(x);  // expect: 12

x *= 2;
system.println(x);  // expect: 24

x /= 4;
system.println(x);  // expect: 6

x %= 4;
system.println(x);  // expect: 2

// Prefix increment/decrement
var a = 5;
system.println(++a);  // expect: 6
system.println(a);    // expect: 6

system.println(--a);  // expect: 5
system.println(a);    // expect: 5

// Postfix increment/decrement
var b = 10;
system.println(b++);  // expect: 10
system.println(b);    // expect: 11

system.println(b--);  // expect: 11
system.println(b);    // expect: 10

// In expressions
var c = 5;
var d = ++c + 2;
system.println(d);  // expect: 8
system.println(c);  // expect: 6

var e = 5;
var f = e++ + 2;
system.println(f);  // expect: 7
system.println(e);  // expect: 6

// In conditions
var count = 0;
while (count < 3) {
    system.println(count++);
}
// expect: 0
// expect: 1
// expect: 2
system.println(count);  // expect: 3

// Multiple operations
var n = 10;
n += 5;
n *= 2;
system.println(n);  // expect: 30

// Chained (prefix returns new value)
var p = 5;
var q = ++p;
var r = ++p;
system.println(p);  // expect: 7
system.println(q);  // expect: 6
system.println(r);  // expect: 7

// Global variables
var global = 100;
global += 50;
system.println(global);  // expect: 150

global++;
system.println(global);  // expect: 151

++global;
system.println(global);  // expect: 152

// Upvalues
func outer() {
    var x = 10;
    
    func inner() {
        x += 5;
        system.println(x);   // expect: 15
        
        system.println(x++);  // expect: 15
        system.println(x);    // expect: 16
        
        system.println(++x);  // expect: 17
        system.println(x);    // expect: 17
    }
    
    inner();
    system.println(x);  // expect: 17
}
outer();

// Class fields
class Counter {
    var count = 0;
    
    func increment() {
        this.count++;
        system.println(this.count);
    }
    
    func add(n) {
        this.count += n;
        system.println(this.count);
    }
    
    func prefixInc() {
        system.println(++this.count);
    }
}

var counter = Counter();
counter.increment();     // expect: 1
counter.increment();     // expect: 2
counter.add(10);         // expect: 12
counter.prefixInc();     // expect: 13

// Edge cases
var zero = 0;
zero++;
system.println(zero);  // expect: 1

var neg = -5;
neg += 10;
system.println(neg);   // expect: 5

// Expression evaluation
var m = 5;
var result = (m++) + (++m);
system.println(result);  // expect: 12
system.println(m);       // expect: 7

// Compound with compound
var y = 10;
y += 5;
y *= 2;
y /= 3;
system.println(y);  // expect: 10

system.println("All tests passed!");  // expect: All tests passed!