import "system";

func ack(m, n) {
  if (m == 0) return n + 1;
  if (m > 0 and n == 0) return ack(m - 1, 1);
  return ack(m - 1, ack(m, n - 1));
}

var start = system.clock();
var result = ack(3, 7);  // A more demanding test
var elapsed = system.clock() - start;

system.println("ack(3,9) = " + result);
system.println("Time: " + elapsed + " seconds");
