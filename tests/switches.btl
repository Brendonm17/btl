import "system";

// as an expression
var x = 2;
var result = switch (x) {
    case 1: break "one";
    case 2: break "two";
    default: break "unknown";
};
system.println(result);                       // expect: two


// as expression in an argument, with blocks
system.println(switch (x) {
    case 1: {
        break "one";
    }
    default: {
        break "other";
    }
});                                  // expect: other

// expression arithmetic
var y = 10 + switch (x) {
    case 1: break 5;
    default: break 0;
};
system.println(y);                            // expect: 10

// fallthrough and statement
switch (y) {
    case 10:
    system.println("zero");
    case 0:
    system.println("and ten");
    break;
    default:
    system.println("default");
    break;
}                                  // expect: zero
                                    // expect: and ten

// fall through to default and statement
switch (y) {
    case 10:
    system.println("0");                      // expect: 0
    case 0:
    system.println("1");                      // expect: 1
    default:
    system.println("2");                      // expect: 2
    break;
}

// default
switch (y) {
    case 5:
    system.println("5");
    break;
    case 8:
    system.println("8");
    break;
    default:
    system.println("other");                      // expect: other
    break;
}

// boolean cases
switch (y) {
    case 5:
    system.println("5");
    break;
    case > 8:
    system.println("8");                          // expect: 8
    break;
    default:
    system.println("other");
    break;
}

var five = 5;

// all mixed up
func oddSwitch(x) {
    var four = 4;
    switch (x) {
        case 1, 2, 3:
            system.println("small");
            break;
        case < 0 or > 100:
            system.println("out of range");
            break;
        case >= 10 and <= 20:
            system.println("teens");
            break;
        case five, four, < 8 or > 50:
            system.println("mixed");
            break;
    }
}

oddSwitch(2);                           // expect: small
oddSwitch(-5);                          // expect: out of range
oddSwitch(16);                          // expect: teens
oddSwitch(5);                           // expect: mixed
oddSwitch(4);                           // expect: mixed
