// as an expression
var x = 2;
var result = switch (x) {
    case 1: break "one";
    case 2: break "two";
    default: break "unknown";
};
print result;                       // expect: two


// as expression in an argument, with blocks
print switch (x) {
    case 1: {
        break "one";
    }
    default: {
        break "other";
    }
};                                  // expect: other

// expression arithmetic
var y = 10 + switch (x) {
    case 1: break 5;
    default: break 0;
};
print y;                            // expect: 10

// fallthrough and statement
switch (y) {
    case 10:
    print "zero";
    case 0:
    print "and ten";
    break;
    default:
    print "default";
    break;
};                                  // expect: zero
                                    // expect: and ten

// fall through to default and statement
switch (y) {
    case 10:
    print "0";                      // expect: 0
    case 0:
    print "1";                      // expect: 1
    default:
    print "2";                      // expect: 2
    break;
}; 

// default
switch (y) {
    case 5:
    print "5";
    break;
    case 8:
    print "8";
    break;
    default:
    print "other";                      // expect: other
    break;
};

// boolean cases
switch (y) {
    case 5:
    print "5";
    break;
    case > 8:
    print "8";                          // expect: 8
    break;
    default:
    print "other";
    break;
};

// all mixed up
func oddSwitch(x) {
    switch (x) {
        case 1, 2, 3:
            print "small";
            break;
        case < 0 or > 100:
            print "out of range";
            break;
        case >= 10 and <= 20:
            print "teens";
            break;
        case 5, < 8 or > 50:
            print "mixed";
            break;
    };
}

oddSwitch(2);                           // expect: small
oddSwitch(-5);                          // expect: out of range
oddSwitch(16);                          // expect: teens
oddSwitch(55);                          // expect: mixed
